# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Primary (development) database.
DATABASE_URL=postgres://user:password@localhost:5432/ai_command_centre

# Isolated database used only by the automated test suite. tests/testDb.ts
# drops and recreates its public schema on every test-file run — never point
# this at the dev or any shared database.
TEST_DATABASE_URL=postgres://user:password@localhost:5432/ai_command_centre_test

# Local filesystem root under which large/binary Artifact bytes are stored
# (Postgres holds only artifact metadata/hash/storage_reference — Phase 12).
ARTIFACT_ROOT=./data/artifacts

# Model-provider credential (Phase 9.6). Read from process.env at call time,
# ONLY inside src/router/providers/anthropic.ts — the single chokepoint. It is
# never placed in a compiled context, a prompt, an Event payload, or an error
# message. Leave EMPTY unless you are deliberately making real, billed API
# calls: every automated test mocks the provider, and an unset/empty value
# makes callAnthropicModel refuse before any network call is attempted.
ANTHROPIC_API_KEY=
# Same rules, for src/router/providers/openai.ts. No tier routes to OpenAI today.
OPENAI_API_KEY=

# The routed default provider is the Claude subscription CLI (`claude -p`),
# which needs no API key. Optional explicit path to the CLI executable;
# otherwise it is resolved from PATH.
# CLAUDE_CLI_PATH=

# API server (src/api/start.ts). Binds loopback by default.
# HOST=127.0.0.1
# PORT=3000
# The web UI's origin: the only browser origin allowed to change state.
# UI_ORIGIN=http://localhost:3100
# Extra comma-separated hostnames the API may be addressed by, beyond loopback.
# API_ALLOWED_HOSTS=

# Optional: a local folder of .md/.txt files searched by the research.retrieve
# local-corpus Tool Binding (config.function "research.retrieve.local_corpus").
# Unset, that binding refuses without consuming anything. The seeded binding is
# the synthetic stub; the corpus binding is used only once a binding row selects it.
# RESEARCH_CORPUS_ROOT=./data/corpus
